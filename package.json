{
  "name": "rentennials-ai-integrations",
  "private": true,
  "type": "module",
  "workspaces": ["views", "openai"],
  "engines": { "node": ">=22.12 <23" },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "yarn workspace rentennials-mcp-views typecheck && yarn workspace rentennials-openai-plugin typecheck",
    "test": "yarn workspace rentennials-mcp-views test",
    "build": "yarn workspace rentennials-mcp-views build",
    "views:dev": "yarn workspace rentennials-mcp-views dev",
    "test:e2e": "yarn workspace rentennials-mcp-views test:e2e",
    "openai:validate": "yarn workspace rentennials-openai-plugin validate",
    "openai:package": "yarn workspace rentennials-openai-plugin build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
